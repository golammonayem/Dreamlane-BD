# Server
PORT=3000

# MySQL / TiDB Cloud Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=dreamlane_bd
DB_PORT=3306
# Set to true if using TiDB Cloud or any SSL-required MySQL host
DB_SSL=false

# JWT Secret (change this to a strong random string)
JWT_SECRET=dreamlane_bd_secret_key_change_me

# Cloudinary (optional - image uploads will be skipped if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
